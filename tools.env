# Canonical tool versions for all bborbe Go projects.
# Each repo should keep its tools.env in sync with the canonical file.
# COUNTERFEITER_VERSION must also match all `//go:generate go run github.com/maxbrunsfeld/counterfeiter/v6@<ver>` directives.

ADDLICENSE_VERSION         ?= v1.2.0
COUNTERFEITER_VERSION      ?= v6.12.2
ERRCHECK_VERSION           ?= v1.20.0
GINKGO_VERSION             ?= v2.28.3
GOIMPORTS_REVISER_VERSION  ?= v3.12.6
GOLANGCI_LINT_VERSION      ?= v2.14.0
GOLINES_VERSION            ?= v0.13.0
GO_MODTOOL_VERSION         ?= v0.7.1
GOSEC_VERSION              ?= v2.26.1
GOVULNCHECK_VERSION        ?= v1.3.0
OSV_SCANNER_VERSION        ?= v2.3.1
# Repo-local: the browser suite's driver. Pinned to the legacy module path
# github.com/mxschmitt/playwright-go, for two measured reasons: the community
# path (github.com/playwright-community/playwright-go) is refused by `go get`
# from v0.6100.0 on — those releases declare the mxschmitt path — and its last
# usable version, v0.6000.0, bundles Playwright 1.60.0, whose driver the retired
# azureedge CDN answers with a 404. Bump both when upstream fixes the path.
PLAYWRIGHT_GO_MODULE       ?= github.com/mxschmitt/playwright-go
PLAYWRIGHT_GO_VERSION      ?= v0.6201.1
